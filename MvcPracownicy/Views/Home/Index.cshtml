@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        background: linear-gradient(135deg, #0f172a, #111827, #1e293b);
        font-family: 'Segoe UI', sans-serif;
        color: white;
    }

    .main-box {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 80vh;
    }

    .main-card {
        background-color: rgba(30, 41, 59, 0.95);
        padding: 50px;
        border-radius: 20px;
        box-shadow: 0 0 25px rgba(59, 130, 246, 0.25);
        text-align: center;
        width: 600px;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .main-card h1 {
        color: #60a5fa;
        font-size: 56px;
        margin-bottom: 15px;
    }

    .main-card p {
        color: #cbd5e1;
        font-size: 20px;
        margin: 0;
    }
</style>

<div class="main-box">
    <div class="main-card">
        <h1>Welcome</h1>
        <p>ASP.NET Core Web Application</p>
    </div>
</div>