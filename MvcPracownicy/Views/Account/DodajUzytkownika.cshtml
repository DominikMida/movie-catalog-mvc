@{
    ViewData["Title"] = "Dodaj nowego użytkownika";
}

<div class="container mt-4" style="max-width: 500px;">
    <h1>Dodaj nowego użytkownika</h1>
    <p class="text-muted">Tylko administratorzy mogą dodawać nowych użytkowników</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="DodajUzytkownika" method="post">
        <div class="mb-3">
            <label for="login" class="form-label">Login</label>
            <input type="text" class="form-control" id="login" name="login" placeholder="Wprowadź login" required>
            <small class="form-text text-muted">Login musi być unikalny</small>
        </div>

        <div class="mb-3">
            <label for="haslo" class="form-label">Hasło</label>
            <input type="password" class="form-control" id="haslo" name="haslo" placeholder="Wprowadź hasło" required>
            <small class="form-text text-muted">Minimum 6 znaków</small>
        </div>

        <div class="mb-3">
            <label for="hasloPotwierdzenie" class="form-label">Potwierdź hasło</label>
            <input type="password" class="form-control" id="hasloPotwierdzenie" name="hasloPotwierdzenie" placeholder="Potwierdź hasło" required>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">Dodaj użytkownika</button>
        </div>
    </form>

    <div class="mt-3">
        <a asp-action="Uzytkownicy" class="btn btn-secondary btn-sm">Wróć do listy użytkowników</a>
    </div>
</div>
