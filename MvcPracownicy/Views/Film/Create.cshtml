                </select>
            </div>
            <div class="form-group">
                <label asp-for="GatunekId" class="control-label"></label>
                <select asp-for="GatunekId" class ="form-control" asp-items="ViewBag.GatunekId">
                    <option value="-1">-- Wybierz gatunek --</option>
                </select>
            </div>
